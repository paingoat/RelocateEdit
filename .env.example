# Read token: https://huggingface.co/settings/tokens
# Copy this file to .env and replace the placeholder. Do not commit .env.
#
# None of the model repos used here are gated, so you do not click
# "Agree and access" on Hugging Face. The token still avoids anonymous
# rate limits on the large AnyDoor file.
HF_TOKEN=hf_your_token_here

# Hugging Face cache. scripts/env.sh creates this directory.
HF_HOME=/workspace/data/huggingface

# Rust-based parallel download. Requires the hf_transfer package,
# which scripts/01_create_env.sh installs.
HF_HUB_ENABLE_HF_TRANSFER=1
